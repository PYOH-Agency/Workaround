{
  "name": "workaround",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "validate": "pnpm check:env && pnpm check:size && pnpm check:ds && pnpm check:isolation && pnpm build && pnpm test",
    "check:env": "node scripts/check-environment.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:ds": "node scripts/check-design-system.mjs",
    "check:isolation": "node scripts/check-feature-isolation.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "supabase db reset && vitest run",
    "test:unit": "vitest run tests/domain tests/lib",
    "test:e2e": "supabase db reset && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:reset": "supabase db reset",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "nodemailer": "^9.0.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
