# Valeurs de la pile Supabase locale (`pnpm supabase start` les affiche).
# Copier dans .env.local et .env.test — aucun projet distant en developpement.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Sel applique avant hachage des codes SMS a usage unique.
SMS_CODE_SALT=

# Secret de signature des liens d'opposition (« je ne souhaite plus etre
# contacte »). Change de valeur = tous les liens deja envoyes cessent de
# fonctionner : ne le tourner qu'en connaissance de cause.
MAIL_OPTOUT_SECRET=

# Operateur SMS. Vide en developpement : le message part vers le collecteur de
# mail local. En production, « brevo » — et l'emetteur alphanumerique doit etre
# declare au registre de l'AF2M au prealable (A-Z et 0-9 uniquement).
SMS_PROVIDER=
SMS_SENDER=DEQUERRE
BREVO_API_KEY=

# SMTP — en developpement, le collecteur de mail de la pile Supabase locale.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM=D’équerre <devis@dequerre.local>

# Secret du travail de fond quotidien (preavis d'echeance, re-controles).
# En production, defini par la planification de l'hebergeur.
CRON_SECRET=

# Sel applique avant hachage des adresses d'origine du formulaire de contact.
# Distinct de celui des codes SMS : lier deux traitements sans rapport
# compromettrait les deux si l'un fuyait.
CONTACT_IP_SALT=

# Cle de chiffrement des secrets au repos — 32 octets en base64.
# `openssl rand -base64 32`. Jamais dans le depot, jamais partagee entre
# environnements : une cle qui fuit rend lisibles tous les jetons stockes.
# Absente du controle d'environnement a dessein — seul un agenda raccorde en a
# besoin, et l'exiger casserait tout worktree qui ne s'en sert pas. Le manque
# se signale a l'usage, bruyamment.
SECRET_KEY=
